UTILS: do;


UTADDEC: procedure(v, out) byte public;
    declare v address;
    declare out address;
    
    declare out$ptr address;
    declare (outs based out$ptr) (6) byte;
    declare tmp(6) byte;
    declare (i, j, digit) byte;

    out$ptr = out;


    i = 0;
    j = 0;

    if v = 0 then do;
        outs(0) = '0';
        outs(1) = 0;
        return 1;
    end;

    do while v>0;
         digit = v mod 10;;
         tmp(i) = '0'+ digit;
         i = i +1;
         v = v / 10;
    end;

    do while i>0 ;
        i = i -1;
        outs(i) = tmp(i);
        j = j + 1;
    end;
    outs(j) = 0;
    return j;

end UTADDEC;

end;