TTY: do;

declare TROWS   literally '24',
        TCOLS   literally '80',
        TCUR_SHOW literally '0',
        TCUR_HIDE literally '1';

$include(TTY.EXT)

declare OUTSZ literally '512';
declare teBuf(OUTSZ) byte;
declare teLen address;


TEFLSH: procedure public;
    declare i address;
    if teLen = 0 then return;
    do i=0 to teLen - 1;
        call CONOUT(teBuf(i));
    end;
    teLen = 0;
end TEFLSH;

TEPUTC: procedure(ch) public;
    declare ch byte;
    if teLen >= OUTSZ then call TEFLSH;
    teBuf(teLen) = ch;
    teLen = teLen + 1;
end TEPUTC;


TEPUTS: procedure(str) public;
    declare str address;
    declare ch$ptr address;
    declare ch based ch$ptr byte;
    ch$ptr = str;
    do while ch <> 0;
        call TEPUTC(ch);
        ch$ptr = ch$ptr + 1;
    end; 
end TEPUTS;

TEPDEC: procedure (v) public;
    declare v address;
    declare b(6) byte;
    declare i byte;
    call UTADDEC(v,.b);
    call TEPUTS(.b);
end TEPDEC;


TEGOTO: procedure (r, c) public;
    declare (r,c) byte;
    call TEPUTC(01BH);
    call TEPUTC('[');
    call TEPDEC(r);
    call TEPUTC(';');
    call TEPDEC(c);
    call TEPUTC('H');
end TEGOTO;

TECLS: procedure public;
    call TEPUTC(01BH);
    call TEPUTS(.('[2J',0));
    call TEPUTC(01BH);
    call TEPUTS(.('[H',0));
end TECLS;

TEEOL: procedure public;
    call TEPUTC(1BH);
    call TEPUTS(.('[K',0));
end TEEOL;

TECUR: procedure(hide) public;
    declare hide byte;
    call TEPUTC(1BH);
    if hide then call TEPUTS(.('[?25l',0));
    else call TEPUTS(.('[?25h',0));
end TECUR;

TEINIT: procedure public;
    teLen = 0;
    call TECUR(TCUR_SHOW);
    call TECLS;
    call TEFLSH;
end TEINIT;

TEDONE: procedure public;
    call TECUR(TCUR_SHOW);
    call TEFLSH;
end TEDONE;

    teLen = 0;

end;