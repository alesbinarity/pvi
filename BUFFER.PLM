BUFFER: do;
$include(PVI.LIT)
$include(BUFFER.EXT)


declare FCBWK structure (DR byte, /* 0 - current, 1 - A, 2 - B */ 
                        FNAME(8) byte, /* filename (upper case) */
                        FEXT(3) byte, /* type of file (extention) */
                        EX byte, /* extent */
                        s1 byte, /* reserved */
                        s2 byte, /* reserved */
                        rc byte, /* record count */
                        d(16) byte,
                        cr byte, /* current record */
                        r(3) byte
                        );
declare DMABUF(128) byte;
/* open file */
BUOPNF: procedure (FCB) byte;
    declare FCB address;

    return BDOS2(0FH, FCB);
end BUOPNF;

/* read file */
BUREADFR: procedure (FCB, DMAB) byte;
    declare FCB address;
    declare DMAB address;
;
    call BDOS1(1AH, DMAB);
    return BDOS2(14H, FCB);
end BUREADFR;

/* close file */
BUCLSF: procedure (FCB) byte;
    declare FCB address;
    return 0;
;
end BUCLSF;



BUINIT: procedure public;

;
/* copy fcb1 */
    call move(36, FCB1, .FCBWK);
    if FCBWK.FNAME(0)=' ' then call ERRSYS(ERNOF);

end BUINIT;

end;